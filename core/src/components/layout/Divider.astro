---
import tile from '../../assets/image/divider/lambda_stack_24_tile.svg';

interface Props {
  // Share of the tile height over which the ground fades from one section colour to the
  // other, centred on the middle. 0 is a hard step. The default is in the divider utility.
  gradient?: number;
  // Blue section above, white below.
  inverse?: boolean;
}

const { gradient, inverse = false } = Astro.props;

// The ground is the `divider` utility in base.css; the tile is laid over it as a second
// background layer. The padding keeps the sections' content clear of the lambdas; the
// ground fills it in the right colour on each side.
const style = [
  gradient !== undefined && `--divider-gradient:${gradient}`,
  `background-image:url(${tile.src}),var(--divider-ground)`,
]
  .filter(Boolean)
  .join(';');
---

<div
  role="separator"
  aria-hidden="true"
  class:list={[
    'divider box-content h-30 w-full bg-center bg-repeat-x py-[96px]',
    inverse && 'divider-inverse',
  ]}
  style={style}
/>
