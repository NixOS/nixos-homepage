---
import tile24 from '../../assets/image/divider/lambda_stack_24_tile.svg';
import tile64 from '../../assets/image/divider/lambda_stack_64_tile.svg';

interface Props {
  // Circumradius in px of the hexagon around each logomark; picks the tile.
  cell?: 24 | 64;
  // Share of the tile height over which the ground fades from one section colour to the
  // other, centred on the middle. 0 is a hard step. The default is in the divider utility.
  gradient?: number;
  // Blue section above, white below.
  inverse?: boolean;
}

const { cell = 64, gradient, inverse = false } = Astro.props;

// Tile height in px and the matching Tailwind class; the generator uses the same figures.
const TILES = {
  24: { src: tile24.src, height: 120, heightClass: 'h-30' },
  64: { src: tile64.src, height: 192, heightClass: 'h-48' },
};
const tile = TILES[cell];

// The ground is the `divider` utility in base.css; the tile is laid over it as a second
// background layer. The padding keeps the sections' content clear of the lambdas; the
// ground fills it in the right colour on each side.
const style = [
  `--divider-tile:${tile.height}px`,
  gradient !== undefined && `--divider-gradient:${gradient}`,
  `background-image:url(${tile.src}),var(--divider-ground)`,
]
  .filter(Boolean)
  .join(';');
---

<div
  role="separator"
  aria-hidden="true"
  class:list={[
    'divider box-content w-full bg-center bg-repeat-x py-[96px]',
    tile.heightClass,
    inverse && 'divider-inverse',
  ]}
  style={style}
/>
