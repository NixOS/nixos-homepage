---
import { Icon } from 'astro-icon/components';
import { getEntry } from 'astro:content';
import { BANNER } from 'astro:env/client';

import Container from '@/components/layout/Container.astro';
import Link from '@/components/util/Link.astro';
import { getNixosLogoUrl } from '@/lib/themes';
import { Image } from 'astro:assets';

const headerMenu = await getEntry('menus', 'header');
const currentBanner = await getEntry('banners', BANNER);

const currentTopRoute = `/${Astro.url.pathname.split('/')[1]}`;

const navbarItemStyle = `transition-colors duration-300 text-center text-primary-white header-light:text-secondary-afghani-blue-15 rounded-2xl`;
const navbarItemInactiveStyle = `bg-secondary-afghani-blue-35 hover:bg-secondary-afghani-blue-25 header-light:bg-secondary-afghani-blue-95 header-light:hover:bg-secondary-afghani-blue-85`;
const navbarItemActiveStyle = `md:text-primary-black bg-secondary-afghani-blue-95 text-primary-black! font-medium header-light:bg-secondary-afghani-blue-85`;
---

<header
  id="site-header"
  class:list={[
    'text-primary-white bg-secondary-afghani-blue-45 sticky top-0 z-50 border-b-2 py-4 font-light transition-[background-color,color,padding,border-color,border-width] duration-300 border-b-transparent',
    'header-light:bg-primary-white header-light:text-primary-black header-light:border-b-secondary-afghani-blue-45 header-light:py-3',
  ]}
>
  {currentBanner && (
    <a
      href={currentBanner.data.sitewide.link.url}
      target="_blank"
      rel="noopener noreferrer"
      class:list={[
        'block font-bold',
        currentBanner.data.sitewide.wrapperClasses,
      ]}
    >
      <Container class:list={['flex items-center justify-between']}>
        <span class="line-clamp-1">{currentBanner.data.sitewide.message}</span>
        <span class:list={['line-clamp-1 cursor-pointer underline']}>
          {currentBanner.data.sitewide.link.text}
        </span>
      </Container>
    </a>
  )}
  <Container class="flex flex-col justify-between md:flex-row md:items-center">
    <div class="my-2 flex items-center justify-between gap-2 text-4xl font-normal md:justify-start">
      <Link href="/" class="grid select-none">
        <Image
          class="col-start-1 row-start-1 h-12 w-auto transition-opacity duration-300 header-light:opacity-0"
          src={getNixosLogoUrl('dark')}
          alt="NixOS - Go to homepage"
        />
        <Image
          class="col-start-1 row-start-1 h-12 w-auto opacity-0 transition-opacity duration-300 header-light:opacity-100"
          src={getNixosLogoUrl('light')}
          alt=""
          aria-hidden="true"
        />
      </Link>

      <button
        aria-label="Main Navigation Toggle"
        aria-controls="navbar-menu"
        aria-expanded="true"
        class="p-4 md:hidden"
        id="navigation-toggle"
      >
        <span class="bg-primary-white header-light:bg-secondary-afghani-blue transition-colors duration-300 mb-1.5 block h-1 w-8"></span>
        <span class="bg-primary-white header-light:bg-secondary-afghani-blue transition-colors duration-300 mb-1.5 block h-1 w-8"></span>
        <span class="bg-primary-white header-light:bg-secondary-afghani-blue transition-colors duration-300 block h-1 w-8"></span>
      </button>
    </div>

    <nav
      aria-label="Main Navigation"
      class="grid pt-3 md:pt-0 grid-cols-2 md:flex flex-col gap-1.5 justify-evenly items-center leading-none md:flex-row md:gap-3 md:pb-0"
      id="navbar-menu"
    >
      {headerMenu.data.items.map((item) => (
        <>
          <Link
            class:list={[
              'h-min min-w-24 my-auto py-2.5 px-3.5 flex justify-between flex-row-reverse md:flex-col gap-1 items-center md:justify-center md:text-sm',
              navbarItemStyle,
              currentTopRoute === item.link
                ? navbarItemActiveStyle
                : navbarItemInactiveStyle,
            ]}
            aria-current={currentTopRoute === item.link ? 'page' : undefined}
            href={item.link}
          >
            <Icon class="h-6 w-6 block pb-0.5" name={item.icon} />
            {item.name}
          </Link>
        </>
      ))}
      <Link
        class:list={[
          'h-min min-w-24 my-auto py-2.5 px-3.5 flex justify-between flex-row-reverse md:flex-col gap-1 items-center md:justify-center md:text-sm',
          navbarItemStyle,
          navbarItemInactiveStyle,
        ]}
        href="https://search.nixos.org"
        aria-label="Nixos package and options search"
        target="_self"
      >
        <Icon
          class="text-primary-white header-light:text-secondary-afghani-blue-45 transition-colors duration-300 h-6 w-6 block"
          name="mdi:search"
        />
        Search
      </Link>
    </nav>
  </Container>
</header>

<script>
  const navigationToggle = document.getElementById('navigation-toggle');
  const navbarMenu = document.getElementById('navbar-menu');

  function toggleMenu() {
    navigationToggle.ariaExpanded =
      navigationToggle.ariaExpanded === 'true' ? 'false' : 'true';
    navbarMenu.classList.toggle('hidden');
    navbarMenu.classList.toggle('flex');
  }
  toggleMenu();

  // fallback for firefox (TODO: remove when timeline-scroll has landed in stable)
  if (!CSS.supports('animation-timeline: scroll()')) {
    const header = document.getElementById('site-header');
    const updateScrolled = () =>
      header.toggleAttribute('data-header-scrolled', window.scrollY > 0);
    updateScrolled();
    window.addEventListener('scroll', updateScrolled, { passive: true });
  }

  navigationToggle.addEventListener('click', () => toggleMenu());
</script>
