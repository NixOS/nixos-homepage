---
import { getEntry } from 'astro:content';
const sponsors = await getEntry('sponsors', 'info');
type SponsorItem = {
    href: string;
    src: string;
    alt: string;
    size?: string;
    class?: string | null;
};
const items = (sponsors?.data.items ?? []) as SponsorItem[];
const large = items.filter((item: SponsorItem) => item.size === 'large');
const small = items.filter((item: SponsorItem) => item.size !== 'large');

function imgClass(item: { size?: string; class?: string | null }) {
    const size =
        item.size === 'large'
            ? 'max-h-22 max-w-48 md:max-w-72'
            : 'max-h-12 max-w-28 md:max-w-38';
    return `${size} opacity-65 grayscale-100 transition-all duration-100 hover:opacity-100 hover:grayscale-0 object-contain ${item.class ?? ''}`;
}
---

<div class="flex flex-col items-center gap-10">
    {
        large.length > 0 && (
            <div class="flex flex-wrap items-center justify-center gap-10">
                {large.map((item) => (
                    <a
                        href={item.href}
                        target="_blank"
                        rel="noopener noreferrer"
                    >
                        <img
                            class={imgClass(item)}
                            src={item.src}
                            alt={item.alt}
                        />
                    </a>
                ))}
            </div>
        )
    }
    {
        small.length > 0 && (
            <div class="flex flex-wrap items-center justify-center gap-8">
                {small.map((item) => (
                    <a
                        href={item.href}
                        target="_blank"
                        rel="noopener noreferrer"
                    >
                        <img
                            class={imgClass(item)}
                            src={item.src}
                            alt={item.alt}
                        />
                    </a>
                ))}
            </div>
        )
    }
</div>
