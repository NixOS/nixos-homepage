---
import Card from '@/components/layout/Card.astro';
import Button from '@/components/ui/Button.astro';
import { Code } from 'astro:components';

const {
  type = 'logo',
  fillStyle = 'gradient',
  color = 'rainbow',
  fontColor = 'black',
  orientation = 'horizontal',
  style = 'regular',
  variant = 'recommended',
}: {
  type?: 'logo' | 'logomark' | 'logotype';
  fillStyle?: string;
  color?: string;
  fontColor?: string;
  orientation?: string;
  style?: string;
  variant?: string;
} = Astro.props;

const urlParts = {
  logo: [type, color, fillStyle, fontColor, style, orientation, variant],
  logomark: [type, color, fillStyle, variant],
  logotype: [type, fontColor, style, variant],
}[type];

const brandUrl = `https://brand.nixos.org/logos/nixos-${urlParts.join('-')}.svg`;

const onDark =
  fontColor === 'white' ||
  (type === 'logomark' && (color === 'white' || color === 'trans'));

const alt = {
  logo: `${style} styled NixOS ${type} in the ${variant} variant filled with ${fillStyle} ${color} colors in a ${orientation} orientation using a ${fontColor} font`,
  logomark: `NixOS ${type} in the ${variant} variant filled with ${fillStyle} ${color} colors`,
  logotype: `NixOS ${type} in the ${variant} variant using the ${style} font in ${fontColor}`,
}[type];
---

<Card>
  <img
    src={brandUrl}
    alt={alt}
    class:list={[
      'w-auto rounded-2xl',
      onDark ? 'bg-primary-black' : 'bg-primary-white',
    ]}
  />
  <div class="mt-1.5 article">
    <Code code={brandUrl} />
  </div>
  <div class="flex w-full justify-end gap-2">
    <Button
      color="semidarkblue"
      size="sm-mobfull"
      href={brandUrl}
      icon="mdi:download"
      label="Download"
    />
  </div>
</Card>
