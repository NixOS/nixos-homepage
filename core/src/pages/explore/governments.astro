---
import PageHeader from '@/components/layout/PageHeader.astro';
import Headline from '@/components/ui/typography/Headline.astro';
import Paragraph from '@/components/ui/typography/Paragraph.astro';
import { getCollection } from 'astro:content';

import Segment from '@/components/layout/Segment.astro';
import Layout from '@/layouts/Layout.astro';

const devices = await getCollection('devices');
---

<Layout title="NixOS for Governments">
    <PageHeader text="NixOS for Governments" />
    <Segment variant="white" yPadding container>
        <Paragraph>
            The IT infrastructure of government bodies can often be hard to
            manage. Differnet departments, consistently changing requirements
            and a fleet of devices that quickly exceeds thousands of devices.
            Over time, these challenging environments can lead to a loss of
            oversight and inconsistencies that may lead to breaches and
            malfunctions. NixOS can help solve these challenges.
        </Paragraph>
        <Headline variant="blue" level={2} class="mb-2">
            Why NixOS for governments?
        </Headline>
    </Segment>
    <Segment variant="blue" yPadding container>
        <Headline variant="white" level={2} class="mb-2">
            What representatives say
        </Headline>
        <Paragraph variant="white" />
    </Segment>
    <Segment variant="white" yPadding container>
        <Headline variant="blue" level={2} class="mb-2">
            Governments already using NixOS
        </Headline>
        <Paragraph variant="black" />
    </Segment>
</Layout>
