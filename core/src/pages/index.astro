---
import { getCollection, getEntry, render } from 'astro:content';
import { BANNER } from 'astro:env/client';
import Container from '../components/layout/Container.astro';
import Button from '../components/ui/Button.astro';
import NixosSearchInput from '../components/ui/NixosSearchInput.astro';
import Layout from '../layouts/Layout.astro';
import { generatePathFromPost } from '../lib/utils';

import Card from '@/components/layout/Card.astro';
import Segment from '@/components/layout/Segment.astro';
import Headline from '@/components/ui/typography/Headline.astro';
import Paragraph from '@/components/ui/typography/Paragraph.astro';
import Link from '@/components/util/Link.astro';
import { Icon } from 'astro-icon/components';
import Banner from '../components/ui/Banner.astro';
import SponsorGroup from '../components/ui/SponsorGroup.astro';
import InlineSVG from '../components/util/InlineSVG.astro';

const landingFeatures = await getCollection('landingFeatures');
const demos = await getEntry('landing', 'demos');
const posts = await getCollection('blog');

const NIX_VERSION = import.meta.env.NIX_STABLE_VERSION;
const NIXOS_VERSION = import.meta.env.NIXOS_STABLE_SERIES;

const currentBanner = await getEntry('banners', BANNER);
const CurrentBannerContent = currentBanner
  ? (await render(currentBanner)).Content
  : undefined;

landingFeatures.sort((a, b) => a.id.localeCompare(b.id));

posts
  .sort((a, b) => {
    const dateA = new Date(a.data.date);
    const dateB = new Date(b.data.date);
    return dateA > dateB ? -1 : 1;
  })
  .filter((p) => {
    return p.id.split('/')?.[0] === 'announcements';
  })
  .reverse();

// The hero's two rotating halves. Both keyframe blocks are generated from these
// lists, so adding or removing a word needs no other change.
//
// The adjectives scroll down and the nouns scroll up. Showing item i means
// translating by -i lh, so scrolling down is i decreasing: the adjectives are
// rendered in reverse and their duplicate leads instead of trails. Either way
// the duplicate is a copy of the word displayed first, so the loop is invisible.
const slidingAdjectives = ['Reproducible', 'Declarative', 'Reliable'];

const slidingNouns = [
  'Software',
  'Operating Systems',
  'Cloud Images',
  'Dev Environments',
  'Deployments',
];

const SLIDE_DWELL = 2.5;
const slideHold = 0.8;
const slidePct = (v) => `${+v.toFixed(4)}%`;
const slideOffset = (n) => (n === 0 ? '0' : `-${n}lh`);

// offsetAt(k) gives the line the window sits on during slot k, in lh.
const slideKeyframes = (name, slots, offsetAt) => {
  const pct = 100 / slots;
  const stops = Array.from({ length: slots }, (_, k) => {
    const start = slidePct(k * pct);
    const held = slidePct(k * pct + pct * slideHold);
    return `  ${start}, ${held} { transform: translateY(${slideOffset(offsetAt(k))}); }`;
  });
  return `@keyframes ${name} {\n${stops.join('\n')}\n  100% { transform: translateY(${slideOffset(offsetAt(slots))}); }\n}`;
};

const heroKeyframes = [
  slideKeyframes('text-slide', slidingNouns.length, (k) => k),
  slideKeyframes(
    'text-slide-down',
    slidingAdjectives.length,
    (k) => slidingAdjectives.length - k,
  ),
].join('\n');
---

<Layout>
  <style is:inline set:html={heroKeyframes} slot="head"></style>
  {CurrentBannerContent ? (
    <CurrentBannerContent />
  ) : (
    <Banner
      wrapperClasses="bg-secondary-afghani-blue-95"
      class="font-heading text-secondary-afghani-blue-45 flex flex-col items-center justify-between gap-1 text-lg font-bold md:flex-row md:pt-8 md:pb-7"
    >
      <b>{posts[0].data.title}</b>
      <a
        href={generatePathFromPost(posts[0])}
        class="text-secondary-afghani-blue-45 hover:text-secondary-afghani-blue-75 inline-flex items-center gap-2"
      >
        Read Announcement
        <Icon name="mdi:arrow-right" />
      </a>
    </Banner>
  )}
  <Segment variant="blue-lambda">
    <Container class="grid lg:grid-cols-2 gap-8 py-8 md:py-16">
      <div class="flex flex-col justify-evenly">
        <Headline
          level={1}
          variant="white"
          class="lg:text-6xl! text-center lg:text-left"
        >
          <div>
            <span class="inline-flex h-lh flex-col overflow-hidden lg:justify-self-end">
              <ul
                class="block animate-text-slide-down leading-tight motion-reduce:animate-none"
                style={`--slide-duration: ${slidingAdjectives.length * SLIDE_DWELL}s`}
              >
                <li aria-hidden="true">{slidingAdjectives[0]}</li>
                {[...slidingAdjectives].reverse().map((word) => (
                  <li>{word}</li>
                ))}
              </ul>
            </span>
            <span class="text-secondary-argentinian-blue-85 inline-flex h-[1lh] flex-col overflow-hidden lg:justify-self-start">
              <ul
                class="block animate-text-slide text-center leading-tight motion-reduce:animate-none lg:text-left"
                style={`--slide-duration: ${slidingNouns.length * SLIDE_DWELL}s`}
              >
                {slidingNouns.map((word) => (
                  <li>{word}</li>
                ))}
                <li aria-hidden="true">{slidingNouns[0]}</li>
              </ul>
            </span>
          </div>
        </Headline>
        <Headline
          level={3}
          variant="white"
          class="text-balance flex flex-col text-center lg:text-left flex-wrap justify-around lg:justify-start gap-1 mt-4 lg:text-4xl"
        >
          <span class="block md:inline">
            Take{' '}
            <span class="text-secondary-argentinian-blue-85">control.</span>
          </span>
          <span class="block md:inline">
            Every{' '}
            <span class="text-secondary-argentinian-blue-85">package.</span>
          </span>
          <span class="block md:inline">
            Every{' '}
            <span class="text-secondary-argentinian-blue-85">dependency.</span>
          </span>
          <span class="block md:inline">
            Every{' '}
            <span class="text-secondary-argentinian-blue-85">machine.</span>
          </span>
        </Headline>
      </div>
      <div class="flex flex-col gap-4">
        <Card
          tag="li"
          class="h-full list-none flex flex-col justify-between"
          variant="dark"
          padding="sm"
        >
          <div class="flex justify-between items-center">
            <Headline level={2} variant="blue" class="flex-1" variant="white">
              Nix
            </Headline>
            <Button
              href="/download"
              color="semidarkblue"
              size="mini"
              icon="mdi:download"
              class="flex-0 min-w-max"
            >
              Download Nix {NIX_VERSION}
            </Button>
          </div>
          <Paragraph class="flex-1" variant="white" size="xl" class="font-bold">
            The Package Manager
          </Paragraph>
          <Paragraph class="flex-1" variant="white" size="lg">
            Nix is a tool that takes a unique approach to package management and
            system configuration. Runs on Linux and macOS, next to the package
            manager you already have.
          </Paragraph>
        </Card>

        <Card
          tag="li"
          class="h-full list-none flex flex-col justify-between"
          variant="dark"
          padding="sm"
        >
          <div class="flex justify-between items-center">
            <Headline level={2} variant="blue" class="flex-1" variant="white">
              NixOS
            </Headline>
            <Button
              href="/download"
              color="semidarkblue"
              size="mini"
              icon="mdi:download"
              class="flex-0 min-w-max"
            >
              Download NixOS {NIXOS_VERSION}
            </Button>
          </div>
          <Headline level={2} variant="white" />
          <Paragraph class="flex-1" variant="white" size="xl" class="font-bold">
            The Linux Distribution
          </Paragraph>
          <Paragraph variant="white" size="lg" class="pb-3">
            NixOS is a Linux distribution built around the Nix package manager
            and Nixpkgs. Describe a laptop or a fleet of servers in reversable
            and repeatable.
          </Paragraph>
        </Card>
      </div>
    </Container>
  </Segment>
  <div class="inline-svg-landing-search-top bg-[39%_100%] bg-no-repeat md:bg-bottom">
    <Headline level={2} center variant="blue" class="text-4xl mt-16">
      Features of the Nix ecosystem
    </Headline>
    <Container class="grid gap-8 pt-16 pb-48 md:grid-cols-3 md:gap-4" tag="ul">
      {landingFeatures.map(async (feature) => {
        const { Content } = await render(feature);
        return (
          <li class="list-none text-center">
            <InlineSVG
              src={feature.data.img}
              class="mx-auto mb-6 h-32 w-auto"
            />
            <Headline level={3} tag="b" variant="blue" center>
              {feature.data.title}
            </Headline>
            <div class="article mt-2 leading-relaxed">
              <Content />
            </div>
          </li>
        );
      })}
    </Container>
  </div>
  <div class="after:bg-divider relative after:bottom-0 after:left-0 after:-mt-48 after:-mb-16 after:block after:h-[30rem] after:w-full after:overflow-hidden after:bg-[url(/divider/landing_search_bottom.svg)] after:bg-cover after:bg-[60%_100%] after:bg-no-repeat">
    <div class="bg-secondary-afghani-blue-95 pt-4">
      <Container class="flex w-full flex-col items-center justify-center gap-4 pt-8 pb-8">
        <Headline level={2} center variant="blue" class="text-4xl">
          Choose from over 140 000 Packages
        </Headline>
        <Paragraph size="xl" class="pb-3 md:w-5/8" center>
          The Nix Packages collection (
          <a
            class="text-secondary-afghani-blue! font-bold"
            href="https://github.com/nixos/nixpkgs"
          >
            Nixpkgs
          </a>
          ) offers a large selection of packages for the Nix package manager.
        </Paragraph>
        <NixosSearchInput collection="packages" withSubmit />
      </Container>
    </div>
  </div>
  <Segment variant="white">
    <Container>
      <Headline variant="blue" level={2} center class="pb-8">
        Our awesome sponsors
      </Headline>
      <SponsorGroup />
      <Paragraph class="my-8 text-center" variant="black" size="sm">
        You want to be one of them?
        <Link href="/backing#sponsorship-tiers" variant="blue">
          Become a sponsor!
        </Link>
      </Paragraph>
    </Container>
  </Segment>
</Layout>
