---
import { getCollection, getEntry, render } from 'astro:content';
import { BANNER } from 'astro:env/client';
import Container from '../components/layout/Container.astro';
import Button from '../components/ui/Button.astro';
import NixosSearchInput from '../components/ui/NixosSearchInput.astro';
import Layout from '../layouts/Layout.astro';
import { generatePathFromPost } from '../lib/utils';

import Card from '@/components/layout/Card.astro';
import Segment from '@/components/layout/Segment.astro';
import Headline from '@/components/ui/typography/Headline.astro';
import Paragraph from '@/components/ui/typography/Paragraph.astro';
import Link from '@/components/util/Link.astro';
import { Icon } from 'astro-icon/components';
import Banner from '../components/ui/Banner.astro';
import SponsorGroup from '../components/ui/SponsorGroup.astro';
import InlineSVG from '../components/util/InlineSVG.astro';

const landingFeatures = await getCollection('landingFeatures');
const demos = await getEntry('landing', 'demos');
const posts = await getCollection('blog');

const NIX_VERSION = import.meta.env.NIX_STABLE_VERSION;
const NIXOS_VERSION = import.meta.env.NIXOS_STABLE_SERIES;

const currentBanner = await getEntry('banners', BANNER);
const CurrentBannerContent = currentBanner
  ? (await render(currentBanner)).Content
  : undefined;

landingFeatures.sort((a, b) => a.id.localeCompare(b.id));

posts
  .sort((a, b) => {
    const dateA = new Date(a.data.date);
    const dateB = new Date(b.data.date);
    return dateA > dateB ? -1 : 1;
  })
  .filter((p) => {
    return p.id.split('/')?.[0] === 'announcements';
  })
  .reverse();

// The hero's rotating words. The keyframes below are derived from this list, so
// adding or removing a word needs no other change. A duplicate of the first word
// is appended in the markup so the loop point is invisible; that makes the number
// of slides one less than the number of rendered <li>.
const slidingWords = [
  'Software',
  'Operating Systems',
  'Cloud Images',
  'Dev Environments',
  'Deployments',
];

const slideSlots = slidingWords.length;
const slideSlotPct = 100 / slideSlots;
const slideHold = 0.8;
const slidePct = (v) => `${+v.toFixed(4)}%`;
const slideOffset = (k) => (k === 0 ? '0' : `-${k}lh`);
const slideKeyframes = `@keyframes text-slide {
${slidingWords
  .map((_, k) => {
    const start = slidePct(k * slideSlotPct);
    const held = slidePct(k * slideSlotPct + slideSlotPct * slideHold);
    return `  ${start}, ${held} { transform: translateY(${slideOffset(k)}); }`;
  })
  .join('\n')}
  100% { transform: translateY(${slideOffset(slideSlots)}); }
}`;
---

<Layout>
  <style is:inline set:html={slideKeyframes} slot="head"></style>
  {CurrentBannerContent ? (
    <CurrentBannerContent />
  ) : (
    <Banner
      wrapperClasses="bg-secondary-afghani-blue-95"
      class="font-heading text-secondary-afghani-blue-45 flex flex-col items-center justify-between gap-1 text-lg font-bold md:flex-row md:pt-8 md:pb-7"
    >
      <b>{posts[0].data.title}</b>
      <a
        href={generatePathFromPost(posts[0])}
        class="text-secondary-afghani-blue-45 hover:text-secondary-afghani-blue-75 inline-flex items-center gap-2"
      >
        Read Announcement
        <Icon name="mdi:arrow-right" />
      </a>
    </Banner>
  )}
  <Segment variant="blue-lambda">
    <Container class="grid grid-cols-1 gap-8 py-8 md:py-16">
      <Container class="grid gap-8 grid-cols-1 items-center">
        <Headline level={1} variant="white" center>
          <div class="grid grid-cols-1 justify-items-center text-3xl sm:text-4xl md:text-5xl lg:grid-cols-2 lg:items-start lg:gap-x-[0.25em]">
            <span class="lg:justify-self-end">Reproducible</span>
            <span class="text-secondary-argentinian-blue-85 inline-flex h-[1lh] flex-col overflow-hidden lg:justify-self-start">
              <ul
                class="block animate-text-slide text-center leading-tight motion-reduce:animate-none lg:text-left"
                style={`--slide-duration: ${slideSlots * 2.5}s`}
              >
                {slidingWords.map((word) => (
                  <li>{word}</li>
                ))}
                <li aria-hidden="true">{slidingWords[0]}</li>
              </ul>
            </span>
          </div>
        </Headline>
        <Headline level={3} variant="white" center class="text-balance">
          <span class="block md:inline">Take control.</span>
          <span class="block md:inline">Every package.</span>
          <span class="block md:inline">Every dependency.</span>
          <span class="block md:inline">Every machine.</span>
        </Headline>
      </Container>
      <Container class="grid gap-8 grid-rows-2 lg:grid-cols-2 lg:grid-rows-1">
        <Card
          tag="li"
          class="h-full list-none flex flex-col justify-between"
          variant="light"
          padding="sm"
        >
          <Headline class="m-4" level={2} variant="blue" center>
            Nix {NIX_VERSION}
          </Headline>
          <Paragraph class="m-4" variant="black" size="lg">
            Nix is a tool that takes a unique approach to package management and
            system configuration. Learn how to make reproducible, declarative
            and reliable software.
          </Paragraph>
          <div class="flex flex-col justify-center gap-4 text-center md:flex-row md:justify-start">
            <Button
              href="/download"
              color="semidarkblue"
              size="mini"
              classList="flex-1 text-xl"
              icon="mdi:download"
            >
              Download
            </Button>
            <Button
              href="/learn"
              color="nixblue"
              size="mini"
              icon="mdi:learn-outline"
              classList="flex-1 text-xl bg"
            >
              Learn More
            </Button>
          </div>
        </Card>

        <Card
          tag="li"
          class="h-full list-none flex flex-col justify-between"
          variant="dark"
          padding="sm"
        >
          <Headline class="m-4" level={2} variant="white" center>
            NixOS {NIXOS_VERSION}
          </Headline>
          <Paragraph class="m-4" variant="white" size="lg">
            NixOS is a Linux distribution built around the Nix package manager
            and Nixpkgs. Learn how to make reproducible, declarative and
            reliable systems.
          </Paragraph>
          <div class="flex flex-col justify-center gap-4 text-center md:flex-row md:justify-start">
            <Button
              href="/download"
              color="white"
              size="mini"
              icon="mdi:download"
              classList="flex-1 text-xl"
            >
              Download
            </Button>
            <Button
              href="/learn"
              color="nixblue"
              size="mini"
              icon="mdi:learn-outline"
              classList="flex-1 text-xl bg"
            >
              Learn More
            </Button>
          </div>
        </Card>
      </Container>
    </Container>
  </Segment>
  <div class="inline-svg-landing-search-top bg-[39%_100%] bg-no-repeat md:bg-bottom">
    <Headline level={2} center variant="blue" class="text-4xl mt-16">
      Features of the Nix ecosystem
    </Headline>
    <Container class="grid gap-8 pt-16 pb-48 md:grid-cols-3 md:gap-4" tag="ul">
      {landingFeatures.map(async (feature) => {
        const { Content } = await render(feature);
        return (
          <li class="list-none text-center">
            <InlineSVG
              src={feature.data.img}
              class="mx-auto mb-6 h-32 w-auto"
            />
            <Headline level={3} tag="b" variant="blue" center>
              {feature.data.title}
            </Headline>
            <div class="article mt-2 leading-relaxed">
              <Content />
            </div>
          </li>
        );
      })}
    </Container>
  </div>
  <div class="after:bg-divider relative after:bottom-0 after:left-0 after:-mt-48 after:-mb-16 after:block after:h-[30rem] after:w-full after:overflow-hidden after:bg-[url(/divider/landing_search_bottom.svg)] after:bg-cover after:bg-[60%_100%] after:bg-no-repeat">
    <div class="bg-secondary-afghani-blue-95 pt-4">
      <Container class="flex w-full flex-col items-center justify-center gap-4 pt-8 pb-8">
        <Headline level={2} center variant="blue" class="text-4xl">
          Choose from over 140 000 Packages
        </Headline>
        <Paragraph size="xl" class="pb-3 md:w-5/8" center>
          The Nix Packages collection (
          <a
            class="text-secondary-afghani-blue! font-bold"
            href="https://github.com/nixos/nixpkgs"
          >
            Nixpkgs
          </a>
          ) offers a large selection of packages for the Nix package manager.
        </Paragraph>
        <NixosSearchInput collection="packages" withSubmit />
      </Container>
    </div>
  </div>
  <Segment variant="white">
    <Container>
      <Headline variant="blue" level={2} center class="pb-8">
        Our awesome sponsors
      </Headline>
      <SponsorGroup />
      <Paragraph class="my-8 text-center" variant="black" size="sm">
        You want to be one of them?
        <Link href="/backing#sponsorship-tiers" variant="blue">
          Become a sponsor!
        </Link>
      </Paragraph>
    </Container>
  </Segment>
</Layout>
